{
  "type": "object",
  "properties": {
    "apiUrl": {
      "type": "string",
      "description": "Office Assistant backend, e.g. http://ai.office.local:8000"
    },
    "keycloakUrl": {
      "type": "string",
      "description": "Keycloak realm URL, e.g. http://keycloak.office.local:8080/realms/company"
    },
    "clientId": {
      "type": "string",
      "description": "Keycloak client ID (default browser-agent)"
    },
    "commsSources": {
      "type": "array",
      "description": "Office apps whose communications the assistant indexes for search",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "listUrl": {
            "type": "string"
          },
          "signInUrl": {
            "type": "string"
          }
        }
      }
    },
    "letterSources": {
      "type": "array",
      "description": "Sites (e.g. e-Office) whose downloaded PDF letters are filed per correspondent and drafted replies for",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "hosts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "letterFolder": {
      "type": "string",
      "description": "Folder inside Downloads where letters are filed (default eOffice)"
    }
  }
}